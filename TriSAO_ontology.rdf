    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#SentimentContext">
        <rdfs:comment>Situational context (Social, Spatial, User, Cultural, etc.).</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#SentimentDomain -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#SentimentDomain">
        <rdfs:comment>Topical domain (NaturalDisaster, Fashion, Political, etc.).</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#SentimentExpression -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#SentimentExpression"/>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Sentimentality -->

