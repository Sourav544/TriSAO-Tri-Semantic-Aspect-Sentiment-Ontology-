    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#hasClothingType -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#hasClothingType"/>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#hasColor -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#hasColor"/>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#hasContext -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#hasContext"/>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#hasEmotionLabel -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#hasEmotionLabel"/>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#hasImageURL -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#hasImageURL"/>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#hasSentimentScore -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#hasSentimentScore"/>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#hasTimestamp -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#hasTimestamp"/>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#hasaspect -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#hasaspect"/>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#hasfeedback -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#hasfeedback"/>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#hasmoodLabel -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#hasmoodLabel"/>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#isContext -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#isContext"/>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#isDomain -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#isDomain"/>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#userRating -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#userRating"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Adoration -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Adoration">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Affection"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Affection -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Affection">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#love"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Aggravation -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Aggravation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#irritation"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Agitation -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Agitation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#irritation"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Alarm -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Alarm">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Horror"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Alienation -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Alienation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Neglect"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Anger -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Anger">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Emotion"/>
        <rdfs:comment>We get angry when something blocks us or when we think we&apos;re being treated unfairly.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Anguish -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Anguish">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Sadness"/>
        <rdfs:comment>Intense sadness or suffering</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Annoyance -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Annoyance">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Anger"/>
        <rdfs:comment>Very mild anger caused by a nuisance or inconvenience.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Apprehension -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Apprehension">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Nervousness"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Aspect -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Aspect"/>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Attraction -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Attraction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Affection"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Audio -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Audio">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#ContentContext"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Aversion -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Aversion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Disgust"/>
        <rdfs:comment>An impulse to avoid something disgusting.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Avoid -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Avoid">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Aversion"/>
        <rdfs:comment>Either physically stay away from whatever is triggering the disgust or keep oneself from thinking about it.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#BROOD -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#BROOD">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Anger"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Bitterness -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Bitterness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Rage"/>
        <rdfs:comment>Anger after unfair treatment.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Bliss -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Bliss">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Cheerfulness"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Cheerfulness -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Cheerfulness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#joy"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Compassion -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Compassion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Affection"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Contempt -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Contempt">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Disgust"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#ContentContext -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#ContentContext">
        <rdfs:comment>The medium of the expression (Text, Image, Audio, Video).</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Crosspatch -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Crosspatch">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#irritation"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#CulturalContext -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#CulturalContext">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#SentimentContext"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Defeatism -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Defeatism">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Neglect"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Dehumanize -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Dehumanize">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Aversion"/>
        <rdfs:comment>Treat someone as though he or she is not a human being; deprive someone of human qualities, personality or spirit.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Dejection -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Dejection">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Neglect"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Sadness"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Desire -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Desire">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Lust"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Despair -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Despair">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Sadness"/>
        <rdfs:comment>The loss of hope that a bad situation will improve or change.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Discouragement -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Discouragement">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Sadness"/>
        <rdfs:comment>A response to repeated failures to accomplish something: the belief that it can&apos;t be done.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Disgust -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Disgust">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Emotion"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Dislike -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Dislike">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Rage"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Distraughtness -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Distraughtness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Sadness"/>
        <rdfs:comment>Sadness that makes it hard to think clearly.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Distress -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Distress">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Nervousness"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Dread -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Dread">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Nervousness"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Eagerness -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Eagerness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#optimism"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Ecstasy -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Ecstasy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#enjoyment"/>
        <rdfs:comment>Rapturous delight. A state of very great happiness, nearly overwhelming.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Embarrassment -->

