    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#abhorrence -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#abhorrence">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Disgust"/>
        <rdfs:comment>A mixture of intense disgust and hatred.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#amazement -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#amazement">
