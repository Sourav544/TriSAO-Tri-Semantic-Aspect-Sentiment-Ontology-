    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Rejection -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Rejection">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Neglect"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Rejoicing -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Rejoicing">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#enjoyment"/>
        <rdfs:comment>A warm, uplifting feeling that people experience when they see acts of human goodness, kindness and compassion. Also called elevation.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Repugnance -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Repugnance">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Disgust"/>
        <rdfs:comment>Strong distaste for something, often a concept or idea.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Resentement -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Resentement">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Rage"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Resignation -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Resignation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Sadness"/>
        <rdfs:comment>The belief that nothing can be done.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Ruminate -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Ruminate">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#panic"/>
        <rdfs:comment>Obsessively think about the emotional experience.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#SIMMER -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#SIMMER">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Anger"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Sadness -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Sadness">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Emotion"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Schadenfreude -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Schadenfreude">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#enjoyment"/>
        <rdfs:comment>Enjoyment of the misfortunes of another person, usually a rival.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Scorn -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Scorn">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Rage"/>
    </owl:Class>
    


