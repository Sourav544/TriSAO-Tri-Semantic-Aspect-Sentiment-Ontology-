    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Withdraw -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Withdraw">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Disgust"/>
        <rdfs:comment>Physically or mentally leave the scene of what is triggering the disgust.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Wrath -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Wrath">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Rage"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Zeal -->

    <owl:Class rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Zeal">
