        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#Surprise"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#awe -->

