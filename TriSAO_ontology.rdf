<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3/"
     xml:base="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:untitled-ontology-3="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3">
        <rdfs:comment>An ontology for modeling sentiment and emotion in textual and multimedia content</rdfs:comment>
        <rdfs:label>The proposed Ontology has name TriSAO (Tri-Semantic Aspect-Sentiment Ontology)</rdfs:label>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#coOccursWith -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#coOccursWith">
        <rdfs:comment>Emotions that frequently co‐occur in the same expression.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#hasCountry -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#hasCountry"/>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#hasCulture -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#hasCulture"/>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#hasDomain -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#hasDomain"/>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#hasEmotion -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#hasEmotion"/>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#hasLanguage -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#hasLanguage"/>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#hasPolarity -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#hasPolarity"/>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#hasSimilarSentiment -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#hasSimilarSentiment"/>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#hasSubjectivity -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#hasSubjectivity">
        <rdfs:comment>Links to a subjectivity classification.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#isDetectedFrom -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/soura/ontologies/2025/5/untitled-ontology-3#isDetectedFrom"/>
    


